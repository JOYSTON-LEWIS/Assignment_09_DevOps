stage('Step 10.2: Ensure Mongo Backup ECR Repo Exists') {
    steps {
        script {
            withCredentials([[
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'JL_AWS_CREDENTIALS',
                accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
            ]]) {
                withEnv([
                    "JL_MONGO_BACKUP_IMAGE_REPO_NAME=${env.JL_MONGO_BACKUP_IMAGE_REPO_NAME}",
                    "JL_AWS_REGION=${env.JL_AWS_REGION_ID}"
                ]) {
                    sh '''
                    echo "🔍 Checking if ECR repo exists..."
                    if ! aws ecr describe-repositories --region "$JL_AWS_REGION" --repository-names "$JL_MONGO_BACKUP_IMAGE_REPO_NAME" > /dev/null 2>&1; then
                        echo "📦 Creating ECR repo: $JL_MONGO_BACKUP_IMAGE_REPO_NAME"
                        aws ecr create-repository --repository-name "$JL_MONGO_BACKUP_IMAGE_REPO_NAME" --region "$JL_AWS_REGION"
                    else
                        echo "✅ ECR repo already exists: $JL_MONGO_BACKUP_IMAGE_REPO_NAME"
                    fi
                    '''
                }
            }
        }
    }
}

stage('Modified Step 10.3: Build and Push Mongo Backup Docker Image') {
    steps {
        script {
            withCredentials([[ 
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'JL_AWS_CREDENTIALS',
                accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
            ]]) {
                withEnv([
                    "JL_MONGO_BACKUP_IMAGE_REPO_NAME=${env.JL_MONGO_BACKUP_IMAGE_REPO_NAME}",
                    "JL_AWS_REGION=${env.JL_AWS_REGION_ID}"
                ]) {
                    sh '''                    
                    export DOCKER_BUILDKIT=0

                    echo "📄 Writing Dockerfile..."
cat > Dockerfile <<EOF
FROM debian:bullseye-slim as builder

RUN apt-get update && apt-get install -y gnupg curl

RUN curl -fsSL https://pgp.mongodb.com/server-6.0.asc | gpg --dearmor -o /usr/share/keyrings/mongodb-server-6.0.gpg

RUN echo "deb [signed-by=/usr/share/keyrings/mongodb-server-6.0.gpg] https://repo.mongodb.org/apt/debian bullseye/mongodb-org/6.0 main" > /etc/apt/sources.list.d/mongodb-org-6.0.list

RUN apt-get update && apt-get install -y mongodb-database-tools

FROM public.ecr.aws/lambda/python:3.12

COPY --from=builder /usr/bin/mongodump /usr/bin/mongodump

RUN pip install --no-cache-dir pymongo boto3

WORKDIR /var/task

COPY backup_script.py .

CMD ["backup_script.lambda_handler"]
EOF

                    echo "📄 Writing backup_script.py..."
cat > backup_script.py << 'EOF'
import os, boto3, subprocess, datetime, sys

mongo_uri = os.getenv("MONGO_URI")
s3_bucket = os.getenv("S3_BUCKET")
backup_prefix = os.getenv("S3_PREFIX", "mongodb_backups")

def run_backup():
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    # Write dump to /tmp folder (writable in Lambda)
    archive_name = f"/tmp/backup_{timestamp}.gz"

    print("Current working dir:", os.getcwd())
    print("Archive path:", archive_name)

    subprocess.run([
        "mongodump",
        f"--uri={mongo_uri}",
        "--archive=" + archive_name,
        "--gzip"
    ], check=True)

    s3 = boto3.client("s3")
    s3.upload_file(archive_name, s3_bucket, f"{backup_prefix}/{os.path.basename(archive_name)}")
    print("Backup uploaded to S3 as", f"{backup_prefix}/{os.path.basename(archive_name)}")

def lambda_handler(event, context):
    try:
        run_backup()
        return {"status": "success"}
    except Exception as e:
        print("Backup failed:", e)
        return {"status": "error", "message": str(e)}

